@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Splunk Operator GitLab Release Train Components
LAYOUT_LEFT_RIGHT()

ContainerDb(vars, "GitLab Release Variables", "GitLab variables", "Release credentials, staging/public targets, signing inputs")
System_Ext(psr, "PSR/k8s-operator", "Release-scale qualification")
System_Ext(operatorhub, "OperatorHub", "Community PR review and merge")
System_Ext(redhat, "Red Hat Certification", "Preflight and certification approval")
System_Ext(public_targets, "Public Targets", "Public registries, GitHub mirror, chart destinations")

Container_Boundary(release_boundary, "GitLab Release Train") {
  Component(project_model, "Single-Repo Release Ownership", "Repository decision", "Release automation stays in the same splunk-operator project as source and validation")
  Component(governance, "Governance Stage", "GitLab jobs", "Promote develop to main through a GitLab MR and approval gates")
  Component(pre_release, "Pre-Release Stage", "GitLab jobs", "Version updates, changelog draft, release branch preparation")
  Component(rc_build, "RC Build Stage", "GitLab jobs", "RC image build, artifact generation, RC publication to staging release targets")
  Component(validation, "Validation Gates", "GitLab jobs", "Smoke, integration, security, and approval gates before final release")
  Component(psr_gate, "PSR Qualification Stage", "GitLab jobs", "Trigger PSR upgrade, app-framework, and performance gates for RC confidence")
  Component(final_release, "Final Release Stage", "GitLab jobs", "Promote RC to final release, sign, verify, and create GitLab release")
  Component(chart_release, "Chart Release Stage", "GitLab jobs", "Package charts, validate publication layout, and prepare certification checks")
  Component(bundle_release, "Bundle / Catalog Stage", "GitLab jobs", "Build and push bundle and catalog artifacts")
  Component(preflight_gate, "Preflight Certification Stage", "GitLab jobs", "Run bundle and container preflight before ecosystem submission")
  Component(ecosystem_submit, "Ecosystem Submission Stage", "GitLab jobs", "Prepare OperatorHub PRs and Red Hat certification submission packs")
  Component(mirror_sync, "Mirror Sync Stage", "GitLab jobs", "Push approved public-facing outputs downstream")
}

Rel(project_model, governance, "anchors release ownership")
Rel(project_model, pre_release, "keeps versioning logic local")
Rel(project_model, rc_build, "keeps build logic local")
Rel(project_model, final_release, "keeps final publication local")
Rel(governance, pre_release, "starts")
Rel(pre_release, rc_build, "feeds release inputs")
Rel(rc_build, validation, "produces RC artifacts")
Rel(validation, psr_gate, "unlocks PSR gate")
Rel(psr_gate, final_release, "gates promotion")
Rel(final_release, chart_release, "unlocks downstream publication")
Rel(final_release, bundle_release, "unlocks downstream publication")
Rel(chart_release, preflight_gate, "feeds chart and bundle publication evidence")
Rel(bundle_release, preflight_gate, "feeds bundle images")
Rel(preflight_gate, ecosystem_submit, "gates external ecosystem submission")
Rel(ecosystem_submit, mirror_sync, "unlocks approved public sync")

Rel(governance, vars, "reads governance inputs")
Rel(pre_release, vars, "reads release metadata inputs")
Rel(rc_build, vars, "reads release registry credentials")
Rel(psr_gate, vars, "reads PSR trigger inputs")
Rel(final_release, vars, "reads signing and publication credentials")
Rel(chart_release, vars, "reads chart release credentials")
Rel(bundle_release, vars, "reads bundle release credentials")
Rel(preflight_gate, vars, "reads preflight and Pyxis inputs")
Rel(ecosystem_submit, vars, "reads submission credentials and metadata")
Rel(psr_gate, psr, "triggers qualification")
Rel(preflight_gate, redhat, "executes certification checks")
Rel(ecosystem_submit, operatorhub, "creates PR-ready payloads")
Rel(mirror_sync, public_targets, "mirrors approved public outputs")

SHOW_LEGEND()
@enduml
