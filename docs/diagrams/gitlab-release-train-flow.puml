@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml

title Splunk Operator GitLab Release Train Flow
LAYOUT_WITH_LEGEND()

Person(release_mgr, "Release Engineer", "Approves and initiates release transitions")
Person(maintainer, "Maintainer", "Reviews release MR and validation gates")
System_Ext(psr, "PSR/k8s-operator", "Upgrade, app-framework, and performance qualification")
System_Ext(operatorhub, "OperatorHub / Community Operators", "External PR-driven catalog review")
System_Ext(redhat, "Red Hat Certification", "Preflight, partner-portal, and certified-operator approval")
System_Ext(public_targets, "Public Targets", "GitHub mirror, public registries, and official chart destinations")

System_Boundary(gitlab_boundary, "GitLab Authoritative Release Plane") {
  Container(repo, "splunk-operator GitLab Project", "GitLab project", "Source, release MR, tags, schedules, release scripts, and release ownership stay in one project")
  Container(ci, "GitLab Release Train", "GitLab CI", "Governance, pre-release, RC build, PSR qualification, final publish, charts, certification, and ecosystem submission in the same project")
  ContainerDb(vars, "GitLab Variables", "Protected variables", "Release credentials, signing keys, chart and bundle destinations")
  Container(release_obj, "GitLab Release", "GitLab release object", "Canonical release metadata and assets")
}

Rel(release_mgr, repo, "1. Starts release action or approves release MR")
Rel(maintainer, repo, "2. Reviews and approves governance gate")
Rel(repo, ci, "3. Starts the linked release train")
Rel(ci, vars, "4. Reads release credentials and signing material")
Rel(ci, psr, "5. Triggers PSR release qualification and records verdicts")
Rel(ci, repo, "6. Creates release MR updates, tags, and release metadata")
Rel(ci, release_obj, "7. Publishes canonical GitLab release")
Rel(ci, redhat, "8. Runs preflight and prepares certification submission")
Rel(ci, operatorhub, "9. Prepares ecosystem PR payloads")
Rel(ci, public_targets, "10. Mirrors validated outputs", "Only after GitLab release success and external approvals")

SHOW_LEGEND()
@enduml
